font-family = "CaskaydiaMono Nerd Font"
font-size = 16

theme = Kanagawa Wave
palette = 2=#4a684a

cursor-style = block
window-decoration = false

mouse-hide-while-typing = true
confirm-close-surface = false

shell-integration = detect
shell-integration-features = true
keybind = shift+enter=text:\n

app-notifications = no-clipboard-copy,no-config-reload

# Shader configurations
# Uncomment one of the following lines to enable a shader:
# custom-shader = ~/.config/ghostty/shaders/glow-rgbsplit-twitchy.glsl
# custom-shader = ~/.config/ghostty/shaders/wave.glsl
# custom-shader = ~/.config/ghostty/shaders/glitch.glsl
custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl
