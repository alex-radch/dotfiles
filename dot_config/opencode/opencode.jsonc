{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "external_directory": {
            // "/tmp/*": "allow",
            "./tmp/*": "allow"
        }
    },
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "google/gemma-4-e2b": {
                    "name": "gemma-4-e2b (local)"
                },
                "google/gemma-4-e4b": {
                    "name": "gemma-4-e4b (local)"
                },
                "google/gemma-4-31b": {
                    "name": "gemma-4-31b (local)"
                },
                "google/gemma-4-12b": {
                    "name": "gemma-4-12b (local)"
                },
                "qwen/qwen3.6-27b": {
                    "name": "qwen3.6-27b (local)"
                },
                "qwen2.5-coder-7b-instruct": {
                    "name": "Qwen Coder 7b 2.5 (local)"
                },
                "omnicoder-9b": {
                    "name": "omnicoder 9b (local)"
                },
                "qwen2.5-coder-3b-instruct": {
                    "name": "Qwen Coder 3b 2.5 (local)"
                }
            }
        },
        "vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "vLLM (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8000/v1"
            },
            "models": {
                "gemma-4-26B-A4B-it-AWQ-4bit": {
                    "name": "gemma-4-26b (vllm)",
                    "max_tokens": 4096,
                    "context_window": 32768
                }
            }
        }
    }
}
